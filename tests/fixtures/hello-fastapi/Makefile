# hello-fastapi — golden-fleece development harness
# Generated by: bash golden-fleece/scaffold/new-project.sh
#
# Quick start:
#   make up      # bring up everything
#   make smoke   # end-to-end smoke test
#   make down    # tear down everything
#   make session # print the autonomous Claude Code session prompt
#
# K8s targets (Helm deploy path):
#   make registry      # start local container registry
#   make image         # build + push image to local registry
#   make helm-install  # deploy to Kind via Helm chart
#   make helm-status   # show release + pod state
#   make helm-uninstall

.PHONY: up down destroy kind-up kind-down registry image \
        helm-install helm-uninstall helm-status \
        observability gitops \
        smoke test session logs

# ── Config ─────────────────────────────────────────────────────────
SHELL         := /bin/bash
GF_DIR        := golden-fleece
GF_CONFIG     := golden-fleece.yaml
KIND_CLUSTER  := hello-fastapi-dev
KIND_CONTEXT  := kind-$(KIND_CLUSTER)
K             := kubectl --context $(KIND_CONTEXT)
REGISTRY      := localhost:5050
IMAGE         := $(REGISTRY)/hello-fastapi
TAG           := dev
APP_PID_FILE  := .gf-app.pid

# ── Full lifecycle ─────────────────────────────────────────────────

up: kind-up app-start
	@echo ""
	@echo "Dev harness is up"
	@echo "  App:  http://localhost:8000/healthz"
	@echo ""
	@echo "Run 'make smoke' to verify everything works."
	@echo "Run 'make session' to get the autonomous session prompt."

down: app-stop kind-down
	@echo "Dev harness is down"

destroy:
	$(MAKE) app-stop
	GF_CONFIG=$(GF_CONFIG) bash $(GF_DIR)/core/targets/kind/teardown.sh

# ── Cluster ────────────────────────────────────────────────────────

kind-up: registry
	GF_CONFIG=$(GF_CONFIG) bash $(GF_DIR)/core/targets/kind/bootstrap.sh
	@# Install enabled stacks based on golden-fleece.yaml
	@awk '/^  observability:/,/^  [a-z]/{if(/enabled:.*true/)exit 0}END{exit 1}' $(GF_CONFIG) 2>/dev/null && \
		GF_CONFIG=$(GF_CONFIG) bash $(GF_DIR)/core/stacks/observability/lgtm/install.sh || true
	@awk '/^  gitops:/,/^  [a-z]/{if(/enabled:.*true/)exit 0}END{exit 1}' $(GF_CONFIG) 2>/dev/null && \
		GF_CONFIG=$(GF_CONFIG) bash $(GF_DIR)/core/stacks/gitops/argocd/install.sh || true
	@grep -qE 'argo-workflows:\s*true' $(GF_CONFIG) 2>/dev/null && \
		GF_CONFIG=$(GF_CONFIG) bash $(GF_DIR)/core/stacks/argo-workflows/install.sh || true

kind-down:
	@if kind get clusters 2>/dev/null | grep -qw $(KIND_CLUSTER); then \
		echo "==> Suspending Kind cluster (not deleting — use 'make destroy' to delete)"; \
		echo "    Cluster persists across sessions. Kind is fast to resume."; \
	else \
		echo "==> Kind cluster '$(KIND_CLUSTER)' does not exist"; \
	fi

# ── App ────────────────────────────────────────────────────────────

app-start:
	@# Bring up compose services first (DB etc.)
	@if [ -f  ]; then \
		echo "==> Starting compose services..."; \
		docker compose -f  up -d ; \
	fi
	@if [ -f $(APP_PID_FILE) ] && kill -0 $$(cat $(APP_PID_FILE)) 2>/dev/null; then \
		echo "==> App already running (PID $$(cat $(APP_PID_FILE)))"; \
	else \
		echo "==> Starting app..."; \
		set -a && source .env.dev && set +a && \
			uvicorn app.main:app --host 0.0.0.0 --port 8000 > .gf-app.log 2>&1 & \
			echo $$! > $(APP_PID_FILE); \
		echo "==> Waiting for app to be ready..."; \
		for i in $$(seq 1 30); do \
			curl -sf http://localhost:8000/healthz > /dev/null 2>&1 && break; \
			sleep 1; \
		done; \
		echo "App running (PID $$(cat $(APP_PID_FILE)))"; \
	fi

app-stop:
	@if [ -f $(APP_PID_FILE) ]; then \
		PID=$$(cat $(APP_PID_FILE)); \
		if kill -0 $$PID 2>/dev/null; then \
			kill $$PID 2>/dev/null || true; \
			sleep 1; \
			kill -0 $$PID 2>/dev/null && kill -9 $$PID 2>/dev/null || true; \
		fi; \
		rm -f $(APP_PID_FILE); \
		echo "App stopped"; \
	fi
	@if [ -f  ]; then \
		docker compose -f  down --remove-orphans; \
	fi

logs:
	@if [ -f .gf-app.log ]; then tail -f .gf-app.log; else echo "No app log found"; fi

# ── Testing ────────────────────────────────────────────────────────

smoke:
	GF_CONFIG=$(GF_CONFIG) bash $(GF_DIR)/core/smoke/lib.sh

test:
	set -a && source .env.dev && set +a && echo 'no test command configured'

# ── Registry + Image ───────────────────────────────────────────────

registry:
	GF_CONFIG=$(GF_CONFIG) bash $(GF_DIR)/core/stacks/registry/kind/setup.sh

image: registry
	@echo "==> Building $(IMAGE):$(TAG)..."
	docker build -t $(IMAGE):$(TAG) .
	docker push $(IMAGE):$(TAG)
	@echo "Image pushed: $(IMAGE):$(TAG)"

# ── Stacks (individual targets) ───────────────────────────────────

observability:
	GF_CONFIG=$(GF_CONFIG) bash $(GF_DIR)/core/stacks/observability/lgtm/install.sh

gitops:
	GF_CONFIG=$(GF_CONFIG) bash $(GF_DIR)/core/stacks/gitops/argocd/install.sh

# ── Helm ───────────────────────────────────────────────────────────

helm-install: image
	$(K) create namespace hello-fastapi --dry-run=client -o yaml | $(K) apply -f -
	helm upgrade --install hello-fastapi ./chart \
		-f chart/values-dev.yaml \
		-n hello-fastapi \
		--kube-context $(KIND_CONTEXT) \
		--wait --timeout 120s
	@echo "Deployed to Kind (http://localhost:8080)"

helm-uninstall:
	helm uninstall hello-fastapi -n hello-fastapi --kube-context $(KIND_CONTEXT) || true
	$(K) delete namespace hello-fastapi --ignore-not-found

helm-status:
	helm status hello-fastapi -n hello-fastapi --kube-context $(KIND_CONTEXT)
	@echo ""
	$(K) -n hello-fastapi get pods

# ── Agent ──────────────────────────────────────────────────────────

session:
	@echo ""
	@echo "════════════════════════════════════════════════════════"
	@echo "  Autonomous Claude Code Session Prompt"
	@echo "  Copy everything below and use as your initial prompt:"
	@echo "════════════════════════════════════════════════════════"
	@echo ""
	@cat AUTONOMOUS-SESSION.md
	@echo ""
