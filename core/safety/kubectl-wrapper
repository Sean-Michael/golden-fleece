#!/usr/bin/env bash
# golden-fleece/core/safety/kubectl-wrapper
# Drop this on PATH as 'kubectl' in a golden-fleece dev session.
# Enforces that ALL kubectl calls target the project's Kind cluster.
#
# This is the hard guardrail — unlike CLAUDE.md guidance which is advisory,
# this wrapper physically prevents touching any other cluster.
#
# Activated by: ck8s session (prepends golden-fleece/core/safety/ to PATH)

GF_CONFIG="${GF_CONFIG:-${PWD}/golden-fleece.yaml}"

# Parse context from config (supports both old and new schema)
_gf_cluster_name() {
  local name
  name=$(grep 'cluster_name:' "${GF_CONFIG}" 2>/dev/null | head -1 \
    | sed 's/.*cluster_name:[[:space:]]*//' | tr -d '"' | tr -d "'")
  if [ -z "${name}" ]; then
    name=$(grep -A1 'cluster:' "${GF_CONFIG}" 2>/dev/null | grep 'name:' | head -1 \
      | sed "s/.*name:[[:space:]]*//" | tr -d '"')
  fi
  echo "${name}"
}

_gf_target_type() {
  local t
  t=$(grep -A1 '^target:' "${GF_CONFIG}" 2>/dev/null | grep 'type:' | head -1 \
    | sed 's/.*type:[[:space:]]*//' | tr -d '"' | tr -d "'")
  echo "${t:-kind}"
}

GF_CLUSTER_NAME=$(_gf_cluster_name)
GF_TARGET_TYPE=$(_gf_target_type)

case "${GF_TARGET_TYPE}" in
  kind)     GF_CONTEXT="kind-${GF_CLUSTER_NAME}" ;;
  k3d)      GF_CONTEXT="k3d-${GF_CLUSTER_NAME}" ;;
  existing)
    GF_CONTEXT=$(grep -A5 '^target:' "${GF_CONFIG}" 2>/dev/null | grep 'context:' | head -1 \
      | sed 's/.*context:[[:space:]]*//' | tr -d '"' | tr -d "'")
    GF_CONTEXT="${GF_CONTEXT:-${GF_CLUSTER_NAME}}"
    ;;
  *)        GF_CONTEXT="kind-${GF_CLUSTER_NAME}" ;;
esac

# If --context is explicitly passed, enforce it matches our allowed context
for arg in "$@"; do
  if [[ "${arg}" == --context=* ]]; then
    passed="${arg#--context=}"
    if [[ "${passed}" != "${GF_CONTEXT}" ]]; then
      echo "BLOCKED: kubectl --context ${passed} is not allowed in a golden-fleece session." >&2
      echo "         Only context '${GF_CONTEXT}' is permitted." >&2
      exit 1
    fi
  fi
done

# Inject --context automatically — all calls are pinned
exec /usr/local/bin/kubectl --context "${GF_CONTEXT}" "$@"
