# golden-fleece.yaml — project configuration for the golden-fleece harness
# Copy this to your project root and fill in the values.
# Run: ck8s init (or gf init) to scaffold everything from this config.

project:
  name: "{{PROJECT_NAME}}"          # used for cluster name, image name, namespace
  description: "{{DESCRIPTION}}"

cluster:
  name: "{{PROJECT_NAME}}-dev"      # kind cluster name (context: kind-<name>)
  ports:
    # Add mappings for any services you want on localhost
    - containerPort: 30800          # your app NodePort
      hostPort: 8080
      protocol: TCP
    # argo-workflows is always added automatically when the stack is enabled

stacks:
  # Which optional stacks to install into the cluster
  argo-workflows: true
  argocd: false
  lgtm: false
  cert-manager: false
  external-secrets: false

registry:
  enabled: true
  port: 5050                        # localhost:<port> for push/pull

app:
  # How golden-fleece starts your app in dev mode (host process, not in k8s)
  start_cmd: "{{APP_START_CMD}}"    # e.g. "uv run fastapi dev app/main.py --port 8000"
  health_url: "{{APP_HEALTH_URL}}"  # e.g. "http://localhost:8000/healthz"
  port: {{APP_PORT}}                # e.g. 8000
  env_file: ".env.dev"              # sourced before start_cmd

  # Optional: compose services to bring up alongside the app
  compose:
    file: "compose.yaml"
    services:
      - db                          # list services that should be started with app

helm:
  chart_dir: "./chart"
  release_name: "{{PROJECT_NAME}}"
  namespace: "{{PROJECT_NAME}}"
  values_dev: "chart/values-dev.yaml"

agent:
  # Informs the AUTONOMOUS-SESSION.md template and SKILL.md
  app_url: "http://localhost:{{APP_PORT}}"
  argo_url: "http://localhost:2746"   # set to "" if argo-workflows stack is disabled
  api_key_env: "API_KEY"              # env var Claude uses for auth in smoke/dev
